// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  category    String
  price       Int
  img              String
  alt              String?
  shortDescription String?
  description      String?
  salePrice        Int?
  stock            Int            @default(0)
  media       ProductMedia[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String   // "image" | "video"
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// role: "ADMIN" | "EDITOR"
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("EDITOR")
  posts        BlogPost[]
  projects     Project[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// status: "draft" | "published"
model BlogPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String?
  coverImage  String?
  content     String       // TipTap JSON serialized as string
  status      String       @default("draft")
  publishedAt DateTime?
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  tags        BlogPostTag[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BlogTag {
  id    String       @id @default(cuid())
  name  String       @unique
  slug  String       @unique
  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// status: "draft" | "published"
model Project {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  excerpt     String?
  coverImage  String?
  content     String           // TipTap JSON serialized as string
  status      String           @default("draft")
  publishedAt DateTime?
  authorId    String
  author      User             @relation(fields: [authorId], references: [id])
  tags        ProjectTagLink[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProjectTag {
  id       String           @id @default(cuid())
  name     String           @unique
  slug     String           @unique
  projects ProjectTagLink[]
}

model ProjectTagLink {
  projectId String
  tagId     String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

// status: "pending" | "approved" | "rejected" | "in_process" | "cancelled"
// type:   "product" | "cotizador" | "mixed"
model Order {
  id                   String      @id @default(cuid())
  preferenceId         String?     @unique
  paymentId            String?
  status               String      @default("pending")
  type                 String      @default("product")
  subtotal             Int         @default(0)
  shippingCost         Int         @default(0)
  shippingMethod       String?     @default("domicilio")
  total                Int
  shippingName         String?
  shippingEmail        String?
  shippingDocType      String?
  shippingDocNumber    String?
  shippingPhone        String?
  shippingAddress      String?
  shippingNeighborhood String?
  shippingAddressExtra String?
  shippingDepartment   String?
  shippingCity         String?
  shippingPostalCode   String?
  shippingInstructions String?
  /// Conversación del asistente de IA de la que salió la compra (medición chat → pago).
  chatSessionId        String?
  items                OrderItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([chatSessionId])
}

// itemType: "product" | "cotizador"
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType  String  @default("product")
  productId String?
  slug      String?
  category  String?
  name      String
  price     Int
  quantity  Int
  note      String?
  modelUrl  String?
}

// Generic key/value store for app configuration
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Conversación anónima del asistente de IA del cotizador (/cotizador/asistente).
// Sin datos personales. Se borra a los 90 días.
// resultado: "carrito" | "derivado" | null (abandonada o en curso)
model ChatSession {
  id            String      @id @default(cuid())
  mensajes      String      // JSON de la conversación (UIMessage[])
  turnos        Int         @default(0)
  modelos       String?     // JSON: modelos que respondieron, marcando si fue un respaldo
  costoUsd      Float       @default(0)
  tokensEntrada Int         @default(0)
  tokensSalida  Int         @default(0)
  resultado     String?
  cotizaciones  ChatQuote[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([createdAt])
}

// Cotización o estimación que el asistente citó con un código.
// tipo: "archivo" | "estimacion"
model ChatQuote {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  codigo    String      // "Q-7F3K" | "E-2M9P"; único dentro de la conversación
  tipo      String
  datos     String      // JSON: archivo, STLData, elección y precios mostrados | medidas, supuesto y rango
  createdAt DateTime    @default(now())

  @@unique([sessionId, codigo])
}

// status: "new" | "contacted" | "resolved"
model ServiceInquiry {
  id        String   @id @default(cuid())
  service   String   // e.g. "repuestos-impresoras"
  name      String
  email     String
  phone     String?
  message   String
  extra     String?  // JSON with service-specific fields
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
